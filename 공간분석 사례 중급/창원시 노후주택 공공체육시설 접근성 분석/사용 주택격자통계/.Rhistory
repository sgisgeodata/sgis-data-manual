# 필요한 패키지 불러오기
library(dplyr)
library(readr)
# 1. 경로 및 파일 설정
# 주택 통계 데이터 불러오기(라라, 라마, 마라, 마마)
folder_path <- "C:/SGIS/QGIS/창원시 노후주택 공공체육시설 접근성 분석"
file_names <- c( "2024년_주택_라라_1K.csv", "2024년_주택_라마_1K.csv", "2024년_주택_마라_1K.csv", "2024년_주택_마마_1K.csv")
# 2000년 이전 노후주택 코드 추출
old_house_codes <- c("ho_yr_001", "ho_yr_002", "ho_yr_003")
# 2. 파일 불러오기 및 노후주택 코드 추출
# 파일별 노후주택 추출 결과를 저장할 빈 목록 생성
old_house_list <- list()
# 파일을 하나씩 불러와 동일한 작업 반복
for (file_name in file_names) {
# 폴더 경로와 파일명을 합쳐 전체 파일 경로 만들기
file_path <- file.path(folder_path, file_name)
# 헤더가 없는 CP949 인코딩 CSV 읽기, 열 이름 지정
house_df <- read_csv(file_path, col_names = c("기준연도", "격자코드", "주택연도코드", "주택수"),
locale = locale(encoding = "CP949"), col_types = cols(.default = col_character()),
show_col_types = FALSE, trim_ws = TRUE)
# 2000년 이전 노후주택 코드에 해당하는 행만 추출
old_house_df <- house_df %>%
filter(주택연도코드 %in% old_house_codes) %>%
mutate(주택수 = parse_number(주택수), 원본파일 = file_name)
# 현재 파일에서 추출한 결과를 목록에 저장
old_house_list[[file_name]] <- old_house_df
}
# 파일별 노후주택 자료를 하나로 합치기
old_house_data <- bind_rows(old_house_list)
# 3. 격자코드별 노후주택 수 합계 계산
old_house_sum <- old_house_data %>%
group_by(격자코드) %>%
summarise(노후주택수_합 = sum(주택수, na.rm = TRUE), .groups = "drop") %>%
arrange(격자코드)
# 4. 결과 확인
head(old_house_sum)
cat("원본 노후주택 행 수:", nrow(old_house_data), "\n")
cat("합산 후 격자 수:", nrow(old_house_sum), "\n")
cat("전체 노후주택 수:", sum(old_house_sum$노후주택수_합, na.rm = TRUE),"\n")
# 5. CSV 저장
output_path <- file.path(folder_path, "2024년_노후주택_2000년이전.csv")
write_excel_csv(old_house_sum, output_path)
cat("저장 완료:", output_path, "\n")
