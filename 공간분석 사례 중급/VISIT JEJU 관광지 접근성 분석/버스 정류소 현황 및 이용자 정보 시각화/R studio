# 2. API 한 페이지 호출 함수 ------------------------------------

get_api_page <- function(url, params) {
  res <- GET(url, query = params)
  
  if (status_code(res) != 200) {
    stop("API 호출 실패: HTTP ", status_code(res))
  }
  
  txt <- content(res, as = "text", encoding = "UTF-8")
  json <- fromJSON(txt, flatten = TRUE)
  
  return(json)
}


# 3. 전체 페이지 수집 함수 --------------------------------------

get_all_pages <- function(url, params = list(), limit = 100) {
  page <- 1
  result_list <- list()
  total_pages <- NA
  
  repeat {
    params$number <- page
    params$limit <- limit
    
    json <- get_api_page(url, params)
    
    if (page == 1) {
      total_pages <- ceiling(json$totCnt / limit)
      message("총 행 수: ", json$totCnt)
      message("예상 총 페이지 수: ", total_pages)
    }
    
    if (page == 1 || page %% 10 == 0) {
      message("수집 중: page = ", page, " / ", total_pages)
    }
    
    if (is.null(json$data) || length(json$data) == 0) {
      break
    }
    
    result_list[[page]] <- as.data.table(json$data)
    
    if (isFALSE(json$hasMore)) {
      break
    }
    
    page <- page + 1
    Sys.sleep(0.3)
  }
  
  result <- rbindlist(result_list, fill = TRUE)
  return(result)
}


# 4. 버스 정류소 기본정보 전체 수집 -----------------------------

bus_station_all <- get_all_pages(
  url = station_api_url,
  params = list(),
  limit = limit_size
)


# 5. 자료형 정리 ------------------------------------------------

bus_station_all[, longitude := as.numeric(longitude)]
bus_station_all[, latitude := as.numeric(latitude)]


# 6. CSV 저장 ---------------------------------------------------

