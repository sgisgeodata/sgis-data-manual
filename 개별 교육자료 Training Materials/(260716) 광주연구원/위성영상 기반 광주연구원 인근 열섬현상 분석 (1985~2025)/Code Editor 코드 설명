// 13. 1985년 대표 LST
// 1984~1986년 여름
//
// 아래 대표연도 처리의 공통 원리
// collectionXXXX: 전후 3개년 여름철 LST 영상 묶음
// lstXXXX: 같은 위치의 여러 관측값 중 중앙값을 취한 대표 LST 영상
// -----------------------------------------------------

// Landsat 5로 1984, 1985, 1986년 여름 영상을 모은다.
var collection1985 = mergeThreeSummers(
  1984,
  1985,
  1986,
  'L5'
);


// size()는 필터링과 전처리 후 실제 남은 영상 수를 Console에 보여준다.
// 영상 수가 0이면 뒤의 median() 결과가 비게 되므로 반드시 확인해야 한다.
print(
  '1985 대표기간 영상 개수 | 1984~1986년 여름',
  collection1985.size()
);


// median()은 픽셀별로 여러 영상의 중앙값을 계산한다.
// 평균보다 극단적인 구름 잔여값이나 비정상 온도의 영향을 덜 받는다.
var lst1985 = collection1985
  .median()
  .rename('LST')
  // clip()은 연구지역 밖 픽셀을 가려 지도와 후속 계산 범위를 제한한다.
  .clip(roi)
  // set()은 결과 영상에 대표연도, 기간, 사용 영상 수 메타데이터를 기록한다.
  .set({
    year: 1985,
    period: '1984-1986',
    image_count: collection1985.size()
  });


