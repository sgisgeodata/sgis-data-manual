// 21. 광주연구원 위치 표시
//
// 빨간색 중심점만 표시
//
// 지도에서 한 픽셀짜리 점은 확대 수준에 따라 잘 보이지 않을 수 있으므로
// 실제 위치점을 반경 70m 원으로 넓혀 눈에 띄는 표식으로 만든다.
// 이 원은 분석용 연구지역이 아니라 위치 안내용 시각 요소이다.
// -----------------------------------------------------

// griCenterCircle 변수
// - 광주연구원의 실제 점 위치를 중심으로 만든 반경 70m 원형 Geometry
// - 분석범위를 뜻하지 않고 지도에서 위치가 잘 보이도록 점을 확대 표현하기 위한 시각화 도형이다.
// 광주연구원 점 주변 70m 원형 Geometry 생성
var griCenterCircle = griPoint.buffer({
  distance: 70
});

// griCenterImage 변수
// - griCenterCircle 내부를 값 1로 채운 단일밴드 래스터 영상
// - Map.addLayer()에서 빨간색 위치표식으로 표시하기 위해 만든다.
// 원형 Geometry를 지도 레이어로 표시할 수 있도록 값 1의 래스터 영상으로 칠한다.
var griCenterImage = ee.Image()
  .byte()
