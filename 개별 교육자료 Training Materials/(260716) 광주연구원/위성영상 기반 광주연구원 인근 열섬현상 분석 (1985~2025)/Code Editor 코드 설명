// -----------------------------------------------------
// 20. 연구지역 외곽선
// -----------------------------------------------------
// Geometry 자체를 바로 선으로 표현하기보다 FeatureCollection으로 바꾼 뒤
// paint()를 이용해 픽셀 영상 형태의 외곽선을 만들어 지도에 올린다.

// roiFeature 변수
// - 원형 Geometry인 roi를 하나의 공간객체 Feature로 변환한 값
// - Feature는 도형과 속성을 함께 가질 수 있어 FeatureCollection과 paint() 입력으로 쓰기 편하다.
// Geometry인 roi를 속성을 가질 수 있는 Feature로 변환한다.
var roiFeature = ee.Feature(
  roi
);

// roiCollection 변수
// - roiFeature 한 개를 목록 형태로 감싼 FeatureCollection
// - 현재는 객체가 하나뿐이지만 paint()의 featureCollection 인수 형식에 맞추기 위해 만든다.
// paint()가 여러 공간객체 묶음을 입력받으므로 FeatureCollection으로 감싼다.
var roiCollection = ee.FeatureCollection([
  roiFeature
]);


// roiOutline 변수
// - 연구지역 경계만 값 1로 칠해진 래스터 영상
// - ee.Image()는 비어 있는 기본 영상을 만들고, byte()는 0~255 정수형으로 바꾼다.
// - paint()는 roiCollection을 영상 위에 그리며 color: 1은 픽셀값, width: 3은 선 두께이다.
// 빈 영상을 byte 정수형으로 만든 뒤 roi 경계를 값 1, 두께 3픽셀로 칠한다.
var roiOutline = ee.Image()
  .byte()
  .paint({
    featureCollection: roiCollection,
    color: 1,
    width: 3
  });


Map.addLayer(
  roiOutline,
  {
    min: 0,
    max: 1,
    palette: [
      'FF0000'
    ]
  },
  '연구지역 | 반경 3km',
  true
);


