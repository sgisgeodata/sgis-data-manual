// 18. LST 시각화 설정
//
// 파란색은 낮은 온도이므로
// 실제 여름철 자료에서는 적을 수 있음
//
// 이 객체는 화면 표현 규칙일 뿐 실제 LST 수치 자체를 바꾸지 않는다.
// min 이하 값은 첫 색, max 이상 값은 마지막 색으로 표현된다.
// palette는 낮은 온도에서 높은 온도로 이어지는 색상 순서이다.
// -----------------------------------------------------

// lstVis 변수
// - LST 영상을 지도에 어떤 온도범위와 색으로 표현할지 저장한 일반 자바스크립트 객체
// - 분석값을 변경하지 않고 화면 표시만 결정한다.
// - 모든 연도에 같은 lstVis를 적용해야 같은 색이 같은 온도를 뜻하므로 시기 비교가 가능하다.
var lstVis = {

  // min 속성
  // - 색상표의 시작점으로 사용할 온도값 26°C
  // - 26°C 이하 값은 첫 번째 색상에 가깝게 표시된다.
  min: 26,

  // max 속성
  // - 색상표의 끝점으로 사용할 온도값 46°C
  // - 46°C 이상 값은 마지막 색상에 가깝게 표시된다.
  max: 46,

  // palette 속성
  // - 낮은 온도에서 높은 온도 순으로 적용할 16진수 RGB 색상코드 배열
  // - 배열의 앞쪽은 파랑·청록, 중간은 초록·노랑, 뒤쪽은 주황·빨강이다.
  palette: [
    '0000FF',
    '00BFFF',
    '00FFFF',
    '00A600',
    'FFFF00',
    'FFA500',
    'FF0000'
  ]

};


