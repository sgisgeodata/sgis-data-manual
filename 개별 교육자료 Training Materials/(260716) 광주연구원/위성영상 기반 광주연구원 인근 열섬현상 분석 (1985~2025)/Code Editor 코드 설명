// -----------------------------------------------------
// 23. LST 범례
// -----------------------------------------------------
// 범례는 lstVis의 색상과 온도값의 대응관계를 사용자가 읽도록 돕는다.
// 색상 배열과 라벨 배열의 같은 인덱스가 하나의 범례 행을 이룬다.

// legendPanel 변수
// - 색상상자, 온도라벨, 결측안내를 순서대로 담는 범례용 UI 패널
// - position: 'bottom-left'로 지도 왼쪽 아래에 고정한다.
// 범례를 지도 왼쪽 아래에 배치한다.
var legendPanel = ui.Panel({

  style: {
    position: 'bottom-left',
    padding: '8px 15px'
  }

});


// legendTitle 변수
// - 범례가 지표면온도 단위 °C를 나타낸다는 제목 라벨
var legendTitle = ui.Label({

  value: '지표면 온도 LST (°C)',

  style: {
    fontWeight: 'bold',
    fontSize: '14px',
    margin: '0 0 6px 0'
  }

});


legendPanel.add(
  legendTitle
);


// legendColors 변수
// - 범례에 표시할 7개 색상코드 배열
// - 반드시 lstVis.palette와 개수와 순서가 같아야 지도색과 범례색이 일치한다.
// lstVis.palette와 같은 순서를 유지해야 지도색과 범례색이 일치한다.
var legendColors = [
  '0000FF',
  '00BFFF',
  '00FFFF',
  '00A600',
  'FFFF00',
  'FFA500',
  'FF0000'
];


// legendLabels 변수
// - legendColors의 각 색상 옆에 표시할 온도 문구 배열
// - 같은 인덱스끼리 한 쌍이므로 두 배열의 길이와 순서를 맞춰야 한다.
// 색상별 대표 온도 문구이다.
// 연속형 색상표이므로 실제 픽셀값은 표시된 값 사이에서도 부드럽게 변한다.
var legendLabels = [
  '26°C',
  '29°C',
  '33°C',
  '36°C',
  '40°C',
  '43°C',
  '46°C 이상'
];


// 반복문은 색상 개수만큼 같은 형식의 범례 행을 자동으로 만든다.
// i는 0부터 시작하며 각 반복이 끝날 때 1씩 증가한다.
for (
  var i = 0;
  i < legendColors.length;
  i++
) {

  // colorBox 변수
  // - 현재 반복번호 i에 해당하는 색상을 배경으로 가진 빈 ui.Label
  // - value는 비워 두고 padding으로 면적을 만들어 작은 색상상자처럼 보이게 한다.
  // 글자 없는 Label의 배경색을 이용해 작은 색상 상자를 만든다.
  var colorBox = ui.Label({

    value: '',

    style: {
      backgroundColor: legendColors[i],
      padding: '8px',
      margin: '0 0 4px 0'
    }

  });


  // valueLabel 변수
  // - 현재 색상상자 옆에 표시할 온도 문구 ui.Label
  // - legendLabels[i]에서 colorBox와 같은 인덱스의 문구를 가져온다.
  // 현재 색상과 같은 인덱스의 온도 라벨을 만든다.
  var valueLabel = ui.Label({

    value: legendLabels[i],

    style: {
      margin: '0 0 4px 6px'
    }

  });


  // legendRow 변수
  // - colorBox와 valueLabel을 한 줄에 묶은 ui.Panel
  // - Flow('horizontal')을 사용하므로 두 위젯이 왼쪽에서 오른쪽으로 배치된다.
  // 색상 상자와 온도 라벨을 가로 방향으로 한 줄에 배치한다.
  var legendRow = ui.Panel({

    widgets: [
      colorBox,
      valueLabel
    ],

    layout: ui.Panel.Layout.Flow(
      'horizontal'
    )

  });


  // 완성된 한 행을 전체 범례 패널의 아래쪽에 추가한다.
  legendPanel.add(
    legendRow
  );
}


// noDataLabel 변수
// - 모든 입력영상에서 유효한 LST가 없었던 픽셀이 빈 영역으로 보인다는 설명 라벨
// - 구름 마스킹, ST 자료 부재, ASTER 방사율 자료 공백 등에 따라 빈 픽셀이 생길 수 있다.
// 유효값이 없는 투명 영역의 의미를 별도 문장으로 안내한다.
var noDataLabel = ui.Label({

  value:
    '흰색·빈 영역: 유효한 LST 값이 없는 픽셀',

  style: {
    fontSize: '11px',
    margin: '6px 0 0 0'
  }

});


legendPanel.add(
  noDataLabel
);


Map.add(
  legendPanel
);


