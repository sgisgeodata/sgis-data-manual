    fontWeight: 'bold',
    fontSize: '18px',
    margin: '0'
  }

});


// subtitleLabel 변수
// - Landsat LST 중앙값과 반경 3km라는 분석조건을 안내하는 보조 라벨
// - titleLabel보다 작은 글씨로 표시된다.
// 두 번째 라벨은 자료 처리 방식과 공간 범위를 설명한다.
var subtitleLabel = ui.Label({

  value:
    'Landsat LST 중앙값 | 광주연구원 반경 3km',

  style: {
    fontSize: '12px',
    margin: '4px 0 0 0'
  }

});


// pointGuideLabel 변수
// - 지도에 표시된 빨간 원이 광주연구원 위치임을 설명하는 안내 라벨
// - 글자색 B00000은 어두운 빨간색 16진수 색상코드이다.
// 세 번째 라벨은 빨간 표식의 의미를 알려준다.
var pointGuideLabel = ui.Label({

 value:
  '● 빨간색 표식: 광주연구원 위치',

  style: {
    fontSize: '11px',
    fontWeight: 'bold',
    color: 'B00000',
