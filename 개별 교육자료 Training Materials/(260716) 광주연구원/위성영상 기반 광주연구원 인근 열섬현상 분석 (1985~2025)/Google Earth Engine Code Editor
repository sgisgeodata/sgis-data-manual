// =====================================================
// GEE Landsat 도시 열섬 변화 시각화 - 완화형 최종 코드
//
// 대상: 광주연구원 주변 반경 3km
// 대표연도: 1985, 1995, 2005, 2015, 2025
//
// 대표기간
// 1985: 1984~1986년 6~8월
// 1995: 1994~1996년 6~8월
// 2005: 2004~2006년 6~8월
// 2015: 2014~2016년 6~8월
// 2025: 2024~2026년 현재 확보된 6~8월 영상
//
// 주요 수정
// 1. 구름 마스킹 완화
// 2. 장면 구름량 80%까지 허용
// 3. 2026년 현재 영상 포함
// 4. 광주연구원 위치 표기
// =====================================================


// -----------------------------------------------------
// 1. 광주연구원 위치 및 연구지역
// -----------------------------------------------------

var GRI_LON = 126.7896149;
var GRI_LAT = 35.1949486;


// 광주연구원 위치
var griPoint = ee.Geometry.Point([
  GRI_LON,
  GRI_LAT
]);


// 반경 3km 연구지역
var roi = griPoint.buffer({
  distance: 3000
});


// 지도 중심
Map.setCenter(
  GRI_LON,
  GRI_LAT,
  12
);


// -----------------------------------------------------
// 2. Landsat Collection 2 Level 2
// -----------------------------------------------------

var landsat5 = ee.ImageCollection(
  'LANDSAT/LT05/C02/T1_L2'
);

var landsat8 = ee.ImageCollection(
  'LANDSAT/LC08/C02/T1_L2'
);

var landsat9 = ee.ImageCollection(
  'LANDSAT/LC09/C02/T1_L2'
);


// -----------------------------------------------------
// 3. QA 비트 산술 추출 함수
//
// bitwiseAnd()를 사용하지 않는 방식
// -----------------------------------------------------

function extractQABit(
  qaImage,
  bitNumber
) {

  var divisor = Math.pow(
    2,
    bitNumber
  );

  return qaImage
    .divide(divisor)
    .floor()
    .mod(2);
}


// -----------------------------------------------------
// 4. Landsat 5 구름 마스킹
//
// 제거
// - Cloud
// - Cloud shadow
//
// 유지
// - Dilated cloud
// - Snow
// - QA_RADSAT
//
// -----------------------------------------------------

function maskLandsat5(inputImage) {

  var image = ee.Image(inputImage);

  var qa = image
    .select('QA_PIXEL')
    .toInt();


  // Bit 3: Cloud
  var cloudBit = extractQABit(
    qa,
    3
  );


  // Bit 4: Cloud shadow
  var cloudShadowBit = extractQABit(
    qa,
    4
  );


  var clearMask = cloudBit
    .eq(0)
    .and(
      cloudShadowBit.eq(0)
    );


  return image
    .updateMask(clearMask)
    .copyProperties(
      image,
      [
        'system:time_start',
        'CLOUD_COVER',
        'PROCESSING_LEVEL'
      ]
    );
}


// -----------------------------------------------------
// 5. Landsat 8/9 구름 마스킹 
// -----------------------------------------------------

function maskLandsat89(inputImage) {

  var image = ee.Image(inputImage);

  var qa = image
    .select('QA_PIXEL')
    .toInt();


  // Bit 2: Cirrus
  var cirrusBit = extractQABit(
    qa,
    2
  );


  // Bit 3: Cloud
  var cloudBit = extractQABit(
    qa,
    3
  );


  // Bit 4: Cloud shadow
  var cloudShadowBit = extractQABit(
    qa,
    4
  );


  var clearMask = cirrusBit
    .eq(0)
    .and(
      cloudBit.eq(0)
    )
    .and(
      cloudShadowBit.eq(0)
    );


  return image
    .updateMask(clearMask)
    .copyProperties(
      image,
      [
        'system:time_start',
        'CLOUD_COVER',
        'PROCESSING_LEVEL'
      ]
    );
}


// -----------------------------------------------------
// 6. Landsat 5 지표면온도 계산
//
// ST_B6
// Kelvin → Celsius
// -----------------------------------------------------

function addLSTLandsat5(inputImage) {

  var image = ee.Image(inputImage);

  var lst = image
    .select('ST_B6')
    .multiply(0.00341802)
    .add(149.0)
    .subtract(273.15)
    .rename('LST');


  return image
    .addBands(lst)
    .copyProperties(
      image,
      [
        'system:time_start',
        'CLOUD_COVER',
        'PROCESSING_LEVEL'
      ]
    );
}


// -----------------------------------------------------
// 7. Landsat 8/9 지표면온도 계산
//
// ST_B10
// Kelvin → Celsius
// -----------------------------------------------------

function addLSTLandsat89(inputImage) {

  var image = ee.Image(inputImage);

  var lst = image
    .select('ST_B10')
    .multiply(0.00341802)
    .add(149.0)
    .subtract(273.15)
    .rename('LST');


  return image
    .addBands(lst)
    .copyProperties(
      image,
      [
        'system:time_start',
        'CLOUD_COVER',
        'PROCESSING_LEVEL'
      ]
    );
}


// -----------------------------------------------------
// 8. Landsat 5 전처리
// -----------------------------------------------------

function prepareLandsat5(
  startDate,
  endDate
) {

  return landsat5

    .filterBounds(roi)

    .filterDate(
      startDate,
      endDate
    )

    // 작은 연구지역이므로 장면 전체 구름량을
    // 80%까지 허용하여 사용 가능한 영상 확보
    .filter(
      ee.Filter.lt(
        'CLOUD_COVER',
        80
      )
    )

    // 지표면온도 밴드가 존재하는 영상만 사용
    .filter(
      ee.Filter.eq(
        'PROCESSING_LEVEL',
        'L2SP'
      )
    )

    .map(maskLandsat5)

    .map(addLSTLandsat5)

    .select('LST');
}


// -----------------------------------------------------
// 9. Landsat 8 전처리
// -----------------------------------------------------

function prepareLandsat8(
  startDate,
  endDate
) {

  return landsat8

    .filterBounds(roi)

    .filterDate(
      startDate,
      endDate
    )

    .filter(
      ee.Filter.lt(
        'CLOUD_COVER',
        80
      )
    )

    .filter(
      ee.Filter.eq(
        'PROCESSING_LEVEL',
        'L2SP'
      )
    )

    .map(maskLandsat89)

    .map(addLSTLandsat89)

    .select('LST');
}


// -----------------------------------------------------
// 10. Landsat 8/9 통합 전처리
// -----------------------------------------------------

function prepareLandsat89(
  startDate,
  endDate
) {

  var merged = landsat8.merge(
    landsat9
  );


  return merged

    .filterBounds(roi)

    .filterDate(
      startDate,
      endDate
    )

    .filter(
      ee.Filter.lt(
        'CLOUD_COVER',
        80
      )
    )

    .filter(
      ee.Filter.eq(
        'PROCESSING_LEVEL',
        'L2SP'
      )
    )

    .map(maskLandsat89)

    .map(addLSTLandsat89)

    .select('LST');
}


// -----------------------------------------------------
// 11. 특정 연도 6~8월 컬렉션 생성
//
// 6월 1일 이상
// 9월 1일 미만
// -----------------------------------------------------

function getSummerCollection(
  year,
  sensorType
) {

  var startDate =
    String(year) + '-06-01';

  var endDate =
    String(year) + '-09-01';


  if (sensorType === 'L5') {

    return prepareLandsat5(
      startDate,
      endDate
    );

  }


  if (sensorType === 'L8') {

    return prepareLandsat8(
      startDate,
      endDate
    );

  }


  return prepareLandsat89(
    startDate,
    endDate
  );
}


// -----------------------------------------------------
// 12. 3개 연도 여름철 컬렉션 병합
// -----------------------------------------------------

function mergeThreeSummers(
  firstYear,
  secondYear,
  thirdYear,
  sensorType
) {

  var firstCollection = getSummerCollection(
    firstYear,
    sensorType
  );

  var secondCollection = getSummerCollection(
    secondYear,
    sensorType
  );

  var thirdCollection = getSummerCollection(
    thirdYear,
    sensorType
  );


  return firstCollection
    .merge(secondCollection)
    .merge(thirdCollection);
}


// -----------------------------------------------------
// 13. 1985년 대표 LST
// 1984~1986년 여름
// -----------------------------------------------------

var collection1985 = mergeThreeSummers(
  1984,
  1985,
  1986,
  'L5'
);


print(
  '1985 대표기간 영상 개수 | 1984~1986년 여름',
  collection1985.size()
);


var lst1985 = collection1985
  .median()
  .rename('LST')
  .clip(roi)
  .set({
    year: 1985,
    period: '1984-1986',
    image_count: collection1985.size()
  });


